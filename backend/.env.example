# ===================================================================
# Radiant Hospital & Research Institute - HMS Environment Configuration
# ===================================================================

# PostgreSQL Database Connection
# Replace with production PostgreSQL credentials
DATABASE_URL="postgresql://postgres:password@localhost:5432/radiant_hms?schema=public"

# App Server Configuration
PORT=4000
NODE_ENV=production

# JWT Authentication Secrets (MUST be at least 32 characters in production)
JWT_SECRET="CHANGE_THIS_TO_SECURE_32_CHAR_RANDOM_SECRET_KEY"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_SECURE_32_CHAR_RANDOM_REFRESH_KEY"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Origin (Set to your hospital intranet URL or domain in production)
CORS_ORIGIN="*"

# ===================================================================
# Ayushman Bharat Digital Mission (ABDM) Integration Configuration
# ===================================================================
# ABDM Environment: 'sandbox' for testing, 'production' for live operations
ABDM_ENV="sandbox"

# ABDM Gateway URL:
# Sandbox: https://dev.abdm.gov.in/gateway
# Production: https://gateway.abdm.gov.in
ABDM_GATEWAY_URL="https://dev.abdm.gov.in/gateway"

# Official ABDM Client Credentials provided by National Health Authority (NHA)
# Keep empty until sandbox/production credentials are issued to Radiant Hospital
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""

# Health Facility Registry (HFR) & HIP Identifiers for Radiant Hospital
ABDM_FACILITY_ID="IN2910000452"
ABDM_HIP_ID="IN_RHRI_BLR_01"

# Mock Provider Setting
# WARNING: Must be 'false' in production. Only permitted when NODE_ENV=test
ABDM_MOCK_ENABLED="false"
ABDM_TIMEOUT_MS=15000
