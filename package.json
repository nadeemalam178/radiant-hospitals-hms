{
  "name": "radiant-hospitals-hms",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready On-Premise Single-Hospital Management System (HMS) with ABDM Integration",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "cd backend && npm start",
    "test": "cd backend && npm test",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:push": "cd backend && npm run prisma:push",
    "prisma:migrate": "cd backend && npx prisma migrate deploy",
    "prisma:init-hospital": "cd backend && npm run prisma:init-hospital",
    "prisma:seed": "cd backend && npm run prisma:seed"
  },
  "keywords": [
    "hospital-management-system",
    "hms",
    "emr",
    "ehr",
    "abdm",
    "abha",
    "on-premise",
    "offline-first",
    "healthcare"
  ],
  "author": "Radiant Health Solutions"
}
